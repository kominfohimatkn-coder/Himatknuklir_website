# Server-side URL to FastAPI. Keep this private; it is never exposed to browser code.
FASTAPI_BASE_URL=http://127.0.0.1:8000

# Normally leave empty so browser requests use the same-origin Next.js proxy.
NEXT_PUBLIC_API_URL=

# Public canonical origin only; never place secrets in NEXT_PUBLIC_* variables.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
