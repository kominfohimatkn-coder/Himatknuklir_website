APP_ENV=development
DEBUG=false
APP_NAME=HIMATKN Website

# MySQL only. Do not commit a real password/credential here.
DATABASE_URL=mysql+pymysql://root@127.0.0.1:3306/himatkn?charset=utf8mb4

# Generate a high-entropy random value of at least 32 characters for real environments.
JWT_SECRET_KEY=REPLACE_WITH_RANDOM_64_PLUS_CHAR_VALUE
JWT_ISSUER=himatkn-api
JWT_AUDIENCE=himatkn-admin
JWT_EXPIRE_MINUTES=30

COOKIE_SECURE=false
COOKIE_SAMESITE=lax
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

ADMIN_DEFAULT_USERNAME=admin
ADMIN_DEFAULT_PASSWORD=subahan_secure_skw
ADMIN_DEFAULT_ROLE=superadmin

AUTO_CREATE_TABLES=true
UPLOAD_DIR=./uploads
MAX_UPLOAD_BYTES=5242880
MAX_REQUEST_BODY_BYTES=10485760

# Development may use memory rate limiting. Production must use Redis.
RATE_LIMIT_BACKEND=memory
RATE_LIMIT_FAIL_CLOSED=true
REDIS_URL=

# Only set trusted reverse-proxy network(s), never arbitrary client ranges.
TRUSTED_PROXY_IPS=

# Optional third-party media storage credential. Store it in the deployment secret manager in production.
BLOB_READ_WRITE_TOKEN=
